{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start BOOKSWAP",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/BOOKSWAP"
            },
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "Local:"
                }
            }
        }
    ]
}